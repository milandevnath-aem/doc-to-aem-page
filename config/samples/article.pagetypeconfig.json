{
  "type": "article",
  "templatePath": "/conf/iffcotokio/settings/wcm/templates/article",
  "contentRoot": "/content/iffcotokio/en",
  "siteOrigin": "https://www.iffcotokio.co.in",
  "damRoot": "/content/dam/iffcotokio/articles",
  "pageResourceType": "iffcotokio/components/page",
  "containerResourceType": "iffcotokio/components/parsys",
  "pageNameStrategy": "slug_from_url",
  "componentMappings": {
    "new-hero-banner": {
      "resourceType": "iffcotokio/components/content/hero-banner-compnent/new-hero-banner",
      "fieldRenames": {
        "title": "bannerTitle",
        "htmltext": "bannerDescription"
      },
      "staticProperties": {
        "cardAlign": "left"
      }
    },
    "page-description": "iffcotokio/components/text",
    "faq": {
      "resourceType": "iffcotokio/components/faq",
      "fieldRenames": {
        "title": "faqTitle"
      },
      "itemFieldRenames": {
        "question": "faqQuestion",
        "htmltext": "faqAnswer"
      }
    },
    "featurecards": {
      "resourceType": "iffcotokio/components/featurecards",
      "itemFieldRenames": {
        "htmltext": "cardText"
      }
    },
    "cardandrte": "iffcotokio/components/cardandrte",
    "cards-with-full-width": "iffcotokio/components/cardswithfullwidth",
    "teasercomponent": "iffcotokio/components/teaser"
  },
  "faq": {
    "cfRoot": "/content/dam/iffcotokio/content-fragments/faq",
    "cfModel": "/conf/iffcotokio/settings/dam/cfm/models/faq-template",
    "tagNamespace": "iffcotokio",
    "pageComponent": {
      "resourceType": "iffcotokio/components/content/faq-cf",
      "pathsProperty": "fragments",
      "countProperty": "limit",
      "staticProperties": {
        "sourceMode": "list"
      }
    }
  },
  "componentSlots": {
    "faq": "root/responsivegrid/right_par/faq"
  }
}
